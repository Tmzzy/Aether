# FastAPI Cloud 运行环境
ENVIRONMENT=production

# 托管服务连接地址
# 使用 FastAPI Cloud 的 Neon/Supabase 集成自动注入 DATABASE_URL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 使用 Redis Cloud 集成时自动注入 REDIS_URL；协议必须与服务商提供的端口一致
# 普通连接使用 redis://，只有服务商明确提供 TLS 端口时才使用 rediss://
REDIS_URL=redis://default:password@host:6379/0

# 安全密钥，必须在 FastAPI Cloud 中标记为 Secret
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-an-independent-random-secret

# 初始管理员，仅首次初始化数据库时使用
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# 不使用 Redis 时，删除 REDIS_URL 并启用以下配置；同时将最大副本数设为 1
# REDIS_REQUIRED=false
# USAGE_QUEUE_ENABLED=false

# 可选的云端运行配置
# LOG_LEVEL=INFO
# DOCS_ENABLED=false
